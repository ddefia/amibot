# Polymarket BTC Trading Bot Configuration
# Copy this file to .env and fill in your values
#
# STRATEGY: Sell-side latency arb (Guy 1's exact approach)
# Reverse-engineered from deep analysis:
#   Guy 1 (dys123): Sharpe 18.62, $131.6k P&L, 53.7% WR, 467 positions
#   - SELLS overpriced contracts at $0.51 (100% sell-side fills)
#   - Pure BTC only, 15-min intervals preferred
#   - $1,000-$2,000 per position, <$5k active exposure
#   - Automated: 0.15s between fills, 42 fills in 58 seconds

# Your Polygon wallet private key (with 0x prefix)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Polymarket CLOB API credentials (auto-derived from private key if empty)
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Strategy settings (tuned from Guy 1's actual trade data)
STRATEGY=latency_arb
MAX_POSITION_SIZE=1500
MAX_EXPOSURE_USDC=10000
MIN_EDGE_THRESHOLD=0.03
MAKER_ONLY=true

# Risk management
# Guy 1's worst loss was $27k on a single position
# Daily P&L swings up to $5k are normal for this strategy
MAX_CONSECUTIVE_LOSSES=8
DAILY_LOSS_LIMIT_USDC=5000
COOLDOWN_AFTER_LOSS_STREAK_SECONDS=600

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
