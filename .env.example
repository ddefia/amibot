# Polymarket Bot Configuration
# Copy this file to .env and fill in your values

# Your Polygon wallet private key (with 0x prefix)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Polymarket CLOB API credentials (auto-derived from private key if empty)
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Strategy settings
STRATEGY=latency_arb
MAX_POSITION_SIZE=100
MAX_EXPOSURE_USDC=500
MIN_EDGE_THRESHOLD=0.05
MAKER_ONLY=true

# Risk management
MAX_CONSECUTIVE_LOSSES=5
DAILY_LOSS_LIMIT_USDC=200
COOLDOWN_AFTER_LOSS_STREAK_SECONDS=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
