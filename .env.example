# Polymarket BTC 5-Min Trading Bot Configuration
# Copy this file to .env and fill in your values
#
# TUNED TO MATCH GUY 1 (best trader):
#   54% win rate, $131K profit, 1.35 profit factor, max 6 loss streak
#   Trades at 180-240s into interval, buys at 50-65c, ~4 shares per trade

# Your Polygon wallet private key (with 0x prefix)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Polymarket CLOB API credentials (auto-derived from private key if empty)
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Strategy settings (tuned from Guy 1's data)
STRATEGY=latency_arb
MAX_POSITION_SIZE=5
MAX_EXPOSURE_USDC=50
MIN_EDGE_THRESHOLD=0.03
MAKER_ONLY=true

# Risk management (conservative — Guy 1 never exceeded 6 losses in a row)
MAX_CONSECUTIVE_LOSSES=8
DAILY_LOSS_LIMIT_USDC=100
COOLDOWN_AFTER_LOSS_STREAK_SECONDS=600

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
