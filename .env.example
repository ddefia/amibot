# Polymarket BTC Trading Bot Configuration
# Copy this file to .env and fill in your values
#
# STRATEGY: Sell-side latency arb (Guy 1's exact approach)
# Reverse-engineered from deep analysis of 5 Polymarket traders:
#   Guy 1 (dys123): Sharpe 18.62, $131.6k P&L, 53.7% WR, 467 positions
#   - SELLS overpriced contracts at $0.51 (100% sell-side fills)
#   - Pure BTC only, 15-min intervals preferred (net +$305K across traders)
#   - $1,000-$2,000 per position, <$5k active exposure
#   - Automated: 0.15s between fills, 42 fills in 58 seconds

# Your Polygon wallet private key (with 0x prefix)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Polymarket CLOB API credentials (auto-derived from private key if empty)
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# === OPERATING MODE ===
# Set to true for paper trading (no real orders placed, but full lifecycle)
DRY_RUN=true

# === PAPER TRADING (only used when DRY_RUN=true) ===
# Starting balance for paper trading
PAPER_BALANCE=50000
# Fill delay range (seconds) — simulates order book matching latency
PAPER_FILL_DELAY_MIN=0.5
PAPER_FILL_DELAY_MAX=5.0
# Fill rate — probability a marketable order fills (simulates liquidity)
# 0.85 = 85% of the time, some orders miss due to thin books
PAPER_FILL_RATE=0.85

# === STRATEGY SETTINGS (tuned from Guy 1's actual trade data) ===
STRATEGY=latency_arb
POSITION_USD=1500
MAX_POSITION_SIZE=2000
MAX_EXPOSURE_USDC=10000
MIN_EDGE_THRESHOLD=0.03
CONFIDENCE_THRESHOLD=0.55
MAKER_ONLY=true
PREFER_15MIN=true

# === RISK MANAGEMENT ===
# Guy 1's worst loss was $27k on a single position
# Daily P&L swings up to $5k are normal for this strategy
MAX_CONSECUTIVE_LOSSES=5
DAILY_LOSS_LIMIT_USDC=5000
COOLDOWN_AFTER_LOSS_STREAK_SECONDS=300
MAX_POSITIONS_PER_INTERVAL=3

# === BANKROLL PROTECTION ===
# Percentage-of-bankroll limits (prevents draining on one trade/market)
# All sizing is capped to these percentages of your ACTUAL USDC balance
MAX_PCT_PER_TRADE=0.05           # Max 5% of bankroll on any single trade
MAX_PCT_PER_INTERVAL=0.15        # Max 15% of bankroll deployed per interval
MAX_PCT_TOTAL_EXPOSURE=0.40      # Max 40% of bankroll in total active exposure
DRAWDOWN_HALT_PCT=0.20           # Stop trading if equity drops 20% from session start
BALANCE_REFRESH_INTERVAL=60      # Re-check actual balance every 60 seconds

# === EXECUTION ===
FILL_CHECK_INTERVAL=5
ORDER_TIMEOUT=60

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FILE=bot.log
TRADE_LOG=trades.jsonl
